<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMeuCombustivel.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="https://images.tcdn.com.br/img/img_prod/155045/bomba_industrial_para_abastecimento_de_gasolina_etanol_e_diesel_vazao_85_l_min_vilubri_1002440_1_43df5f847b808dff78775446b35f58a5.jpg"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a submarine number ten" />

            <Label Text="VALOR ETANOL" x:Name="lbl_etanol" />
            <Entry x:Name="txt_etanol" Placeholder="R$"/>

            <Label Text="VALOR GASOLINA" x:Name="lbl_gasolina"/>
            <Entry x:Name="txt_gasolina" Placeholder="R$"/>

            <Button Text="Qual compensa mais?" Clicked="Button_Clicked"/>
        </VerticalStackLayout>

    </ScrollView>
    

</ContentPage>
